APP_ENV=development

POSTGRES_SERVER=postgres
POSTGRES_DB=smart_job_tracker
POSTGRES_USER=smart_job_tracker
POSTGRES_PASSWORD=smart_job_tracker_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://smart_job_tracker:smart_job_tracker_password@postgres:5432/smart_job_tracker

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=UTC

# Optional SMTP config for reminders/weekly email (Phase: automation layer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS (optional)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

